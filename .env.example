# Ambiente
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# URLs e Roteamento Multi-Tenant
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PREVIEW_BASE_DOMAIN=preview.localhost
NEXT_PUBLIC_PREVIEW_BASE_DOMAIN=preview.localhost
PLATFORM_CNAME_TARGET=sites.plataforma.com.br
PLATFORM_PUBLIC_IP=203.0.113.10

# Banco de Dados (PostgreSQL + PostGIS em produção, ou PGlite local para zero-config)
# Produção: postgres://postgres:postgres@localhost:5432/prospeccao
DATABASE_URL=pglite://./data/pgdata

# Redis & Filas (BullMQ em produção com REDIS_URL; fallback automático em memória se vazio)
REDIS_URL=
QUEUE_DRIVER=auto

# Segurança & Criptografia (RNF-04)
JWT_SECRET=dev-super-secret-jwt-key-change-in-production-32chars
# Chave AES-256-GCM em hexadecimal (64 chars = 32 bytes)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SANDBOX_WEBHOOK_SECRET=sandbox-hmac-secret-dev-key

# Storage (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Integrações Externas (opcionais em dev -> fallback sandbox determinístico)
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto

# Mensageria WhatsApp & Email
WHATSAPP_PROVIDER=auto
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
META_CLOUD_API_TOKEN=
META_PHONE_NUMBER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@plataforma.com.br

# Pagamentos (Stripe / Asaas / Sandbox)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# SSL Automatizado (Caddy On-Demand TLS ou Cloudflare for SaaS)
CADDY_ADMIN_URL=http://localhost:2019
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Governança e Regras Operacionais
BUSINESS_HOURS_ENFORCE=true
GEO_CACHE_TTL_DAYS=15
PREVIEW_EXPIRATION_DAYS=14
QUARANTINE_DAYS=30
